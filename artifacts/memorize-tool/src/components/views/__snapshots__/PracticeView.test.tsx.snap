exports[`PracticeView > renders the practice heading, context and the verify/finish buttons 1`] = `
<div
  class="practice-view"
>
  <h1>
    Practice Mode
  </h1>
  <div
    class="progress-bar"
  >
    <div
      class="progress-fill"
    />
  </div>
  <div
    class="context-section"
  >
    <h3>
      Context:
    </h3>
    <div
