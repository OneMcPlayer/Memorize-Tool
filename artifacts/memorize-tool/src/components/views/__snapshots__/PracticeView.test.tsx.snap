      class="secondary-btn finish-btn"
      id="skipButton"
    >
      Finish Practice
      <span
        class="checkmark"
      >
        ✓
      </span>
    </button>
  </div>
  <div
    class="center"
  >
    <button
      class="secondary-btn restart-btn"
    >
      Restart
    </button>
  </div>
</div>
`;

exports[`PracticeView > shows the completion screen after finishing the last line 1`] = `
<div
  class="practice-view"
>
  <h1>
    Practice Mode
  </h1>
  <div
    class="progress-bar"
  >
    <div
      class="progress-fill"
      style="width: 100%;"
    />
  </div>
  <div
    class="complete-message"
  >
    <h2>
      Practice complete! Well done! 🎭
    </h2>
    <p>
      You have completed practicing all your lines!
    </p>
