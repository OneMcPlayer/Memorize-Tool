# Memorize Tool portable environment template.
# Copy to .env.local for local development, then fill in real values.
#
# Shell loading:
#   set -a; source .env.local; set +a

# Required by the API access gate.
MAIN_ACCESS_TOKEN=replace-with-a-shared-access-code

# Required to sign passkey session JWTs. Use a long random value.
SESSION_SECRET=replace-with-a-long-random-secret

# Required for Live mode TTS/STT through OpenRouter.
OPENROUTER_API_KEY=replace-with-openrouter-api-key

# Required by Drizzle/PostgreSQL.
DATABASE_URL=postgresql://memorize:memorize@127.0.0.1:54329/memorize_dev

# API server bind settings. Use HOST=0.0.0.0 only when your dev environment
# needs public/container access, such as GitHub Codespaces.
HOST=127.0.0.1
PORT=8080

# Frontend dev/preview settings. Use these in the frontend shell.
BASE_PATH=/
API_PROXY_TARGET=http://127.0.0.1:8080

# Portable TTS cache provider:
#   filesystem            default outside Replit
#   none                  disable backend TTS cache
#   replit-object-storage optional Replit Object Storage provider
TTS_CACHE_PROVIDER=filesystem
TTS_CACHE_DIR=artifacts/api-server/output/tts-cache

# Optional diagnostics output.
ENABLE_DIAG_ROUTES=auto
DIAG_REQUIRE_AUTH=auto
DIAG_REQUIRE_ADMIN=auto
DIAG_ADMIN_TOKEN=replace-with-local-admin-token-if-needed
DIAG_LOG_PATH=artifacts/api-server/output/diag-session-logs.jsonl

# Optional Replit-only Vite plugins. Leave disabled for portable dev.
ENABLE_REPLIT_VITE_PLUGINS=false
