# Memorize Tool production environment template.
# Copy to .env.production on the VPS, set mode 600, and fill in real values.
# Do not commit .env.production.

NODE_ENV=production
LOG_LEVEL=info

# Bind services to localhost; Caddy exposes HTTPS publicly.
HOST=127.0.0.1
API_PORT=8080
WEB_PORT=25868
BASE_PATH=/
API_PROXY_TARGET=http://127.0.0.1:8080

# Required secrets. Replace every placeholder before deployment.
MAIN_ACCESS_TOKEN=replace-with-shared-access-token
SESSION_SECRET=replace-with-long-random-session-secret
OPENROUTER_API_KEY=replace-with-openrouter-api-key
DATABASE_URL=postgresql://user:password@127.0.0.1:5432/memorize

# Passkey/WebAuthn public origin.
WEBAUTHN_RP_ID=epicserver.vpsgh.it
WEBAUTHN_ORIGIN=https://epicserver.vpsgh.it

# Diagnostics are disabled in production unless explicitly enabled.
# When enabled, uploads require MAIN_ACCESS_TOKEN and reads require
# DIAG_ADMIN_TOKEN by default.
ENABLE_DIAG_ROUTES=false
DIAG_REQUIRE_AUTH=true
DIAG_REQUIRE_ADMIN=true
DIAG_ADMIN_TOKEN=replace-with-long-random-admin-token
WEB_HEALTH_URL=https://epicserver.vpsgh.it/
DIAG_LOG_PATH=artifacts/api-server/output/diag-session-logs.jsonl

# Portable filesystem cache for generated TTS audio.
TTS_CACHE_PROVIDER=filesystem
TTS_CACHE_DIR=artifacts/api-server/output/tts-cache

# Replit-only Vite plugins remain disabled for VPS deployment.
ENABLE_REPLIT_VITE_PLUGINS=false
